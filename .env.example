# Set server-only values in the EXISTING Vercel project's environment variables.
# Never commit real keys or copy them into site-config.js.
SITE_URL=https://royaltservices.in
APP_URL=https://royaltservices.in
SUPABASE_URL=https://vjnfefdfvneiqbkduezt.supabase.co
# Use the hosted Edge backend locally without a privileged key:
SUPABASE_EDGE_URL=https://vjnfefdfvneiqbkduezt.supabase.co/functions/v1/royalt-api
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Each secret should contain at least 32 random characters.
CRON_SECRET=
RATE_LIMIT_SECRET=
# Tracking credentials only. No real carrier booking is enabled.
DHL_TRACKING_API_KEY=
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ENVIRONMENT=sandbox
# Optional local development: LEGACY_BACKEND=true enables the old file store.
# Vercel always uses Supabase and ignores LEGACY_BACKEND.
