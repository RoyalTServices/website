# Set these in Vercel Project Settings > Environment Variables.
# Never paste database credentials into site-config.js or commit a real .env file.
SITE_URL=https://royaltservices.in
# A pooled PostgreSQL connection URL from your Vercel Marketplace integration.
DATABASE_URL=
# A random secret of at least 32 characters, required for first staff account setup.
STAFF_SETUP_KEY=
